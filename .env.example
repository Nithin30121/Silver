# SILVORA: website environment variables (read by Vite at build time).
#
# Copy this file to .env.local (git-ignored) and fill in your Supabase project's values:
#   Supabase dashboard -> your project -> "Connect" button (or Project Settings -> API Keys).
# On your hosting platform, set the same variables in its environment-variable settings.
#
# Everything here is bundled into the public website, so ONLY public values belong here.
# NEVER put a secret key (sb_secret_...), the legacy service_role key, or the database password here.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# Publishable key (recommended), e.g. sb_publishable_...
VITE_SUPABASE_PUBLISHABLE_KEY=

# Older projects may only offer the legacy "anon" key (a long token starting with eyJ...).
# If so, leave VITE_SUPABASE_PUBLISHABLE_KEY empty and set this instead. Both are public keys.
# VITE_SUPABASE_ANON_KEY=
