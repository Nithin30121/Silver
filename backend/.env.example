# Backend-only secrets. Never place these in VITE_ variables or commit .env.
SUPABASE_DB_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres
SUPABASE_DB_PASSWORD=

# Public verification endpoint; Spring Security validates user access tokens with it.
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
SERVER_PORT=8080

# Optional first-admin bootstrap. Set this to the owner's existing account email for one backend
# start, then clear it. It never creates an account and never grants roles through the browser.
APP_INITIAL_ADMIN_EMAIL=
