# Backend-only secrets. Never place these in VITE_ variables or commit .env.
SUPABASE_DB_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres
SUPABASE_DB_PASSWORD=

# Public verification endpoint; Spring Security validates user access tokens with it.
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# Optional: token signing algorithms to accept (default ES256,RS256). Supabase signs with ES256 by default.
# SUPABASE_JWT_ALGORITHMS=ES256,RS256
# Server-only credentials for product image uploads. Never use a VITE_ prefix.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_STORAGE_SECRET_KEY=
# Optional: the project secret key for deleting a customer's sign-in when they delete their account.
# Leave it unset to use SUPABASE_STORAGE_SECRET_KEY, which is the same project secret.
# SUPABASE_SECRET_KEY=
SUPABASE_PRODUCT_IMAGE_BUCKET=product-images
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
SERVER_PORT=8080

# Optional first-admin bootstrap. Set this to the owner's existing account email for one backend
# start, then clear it. It never creates an account and never grants roles through the browser.
APP_INITIAL_ADMIN_EMAIL=

# Optional customer order emails (order received, confirmed, shipped, delivered, cancelled).
# They stay off until SMTP_HOST and APP_MAIL_FROM are set. Use your email provider's SMTP details.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# The sender customers see, for example: SILVORA <orders@your-domain.com>
APP_MAIL_FROM=
# Optional link at the bottom of each email, for example your storefront address.
APP_SHOP_URL=
# Time zone for the dashboard's "this week" and "this month" figures (default Asia/Kolkata).
# APP_REPORTS_TIME_ZONE=Asia/Kolkata
